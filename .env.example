# Copy to `.env` and adjust. docker compose reads this file automatically.

# ---- PostgreSQL ----
POSTGRES_DB=taxpulse
POSTGRES_USER=taxpulse
POSTGRES_PASSWORD=change-me-strong-password

# ---- Security ----
# HMAC-SHA256 signing key for JWTs. MUST be at least 32 bytes (256 bits).
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=PT8H

# AES-256 key that encrypts stored client credentials (TAXISnet, e-ΕΦΚΑ). Generate with:
#   openssl rand -base64 32
# Back it up somewhere safe: without it the stored credentials cannot be decrypted.
CREDENTIALS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Bootstrap administrator (created only when the users table is empty)
TAXPULSE_ADMIN_EMAIL=admin@taxpulse.local
TAXPULSE_ADMIN_PASSWORD=ChangeMe!2026

# Comma separated list of origins allowed to call the API (frontend dev server, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- Ollama (local LLM) ----
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
